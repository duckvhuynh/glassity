{
  "name": "glassity",
  "version": "0.3.5",
  "description": "Liquid-glass material for any SVG icon. One provider, real refraction, WebGL2.",
  "type": "module",
  "license": "MIT",
  "author": "Duc Huynh (https://github.com/duckvhuynh)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/duckvhuynh/glassity.git"
  },
  "homepage": "https://duckvhuynh.github.io/glassity/",
  "bugs": {
    "url": "https://github.com/duckvhuynh/glassity/issues"
  },
  "sideEffects": [
    "./dist/auto.js",
    "./dist/auto.cjs",
    "./dist/glassity.global.js"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/glassity.global.js",
  "jsdelivr": "./dist/glassity.global.js",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/react.d.ts",
        "default": "./dist/react.js"
      },
      "require": {
        "types": "./dist/react.d.cts",
        "default": "./dist/react.cjs"
      }
    },
    "./auto": {
      "import": {
        "types": "./dist/auto.d.ts",
        "default": "./dist/auto.js"
      },
      "require": {
        "types": "./dist/auto.d.cts",
        "default": "./dist/auto.cjs"
      }
    },
    "./vue": {
      "import": {
        "types": "./dist/vue.d.ts",
        "default": "./dist/vue.js"
      },
      "require": {
        "types": "./dist/vue.d.cts",
        "default": "./dist/vue.cjs"
      }
    },
    "./svelte": {
      "import": {
        "types": "./dist/svelte.d.ts",
        "default": "./dist/svelte.js"
      },
      "require": {
        "types": "./dist/svelte.d.cts",
        "default": "./dist/svelte.cjs"
      }
    },
    "./solid": {
      "import": {
        "types": "./dist/solid.d.ts",
        "default": "./dist/solid.js"
      },
      "require": {
        "types": "./dist/solid.d.cts",
        "default": "./dist/solid.cjs"
      }
    },
    "./angular": {
      "import": {
        "types": "./dist/angular.d.ts",
        "default": "./dist/angular.js"
      },
      "require": {
        "types": "./dist/angular.d.cts",
        "default": "./dist/angular.cjs"
      }
    },
    "./remix": {
      "import": {
        "types": "./dist/remix.d.ts",
        "default": "./dist/remix.js"
      },
      "require": {
        "types": "./dist/remix.d.cts",
        "default": "./dist/remix.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "react": [
        "./dist/react.d.ts"
      ],
      "auto": [
        "./dist/auto.d.ts"
      ],
      "vue": [
        "./dist/vue.d.ts"
      ],
      "svelte": [
        "./dist/svelte.d.ts"
      ],
      "solid": [
        "./dist/solid.d.ts"
      ],
      "angular": [
        "./dist/angular.d.ts"
      ],
      "remix": [
        "./dist/remix.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "get-started.md",
    "skills"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:compat": "node compat/run.mjs",
    "bench": "node bench/run.mjs",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm test && npm run build",
    "demo": "node demo/serve.mjs",
    "demo:build": "node demo/build.mjs",
    "site:build": "node site/build.mjs && npm --prefix site/examples run build",
    "site": "npm run site:build && node demo/serve.mjs"
  },
  "peerDependencies": {
    "@angular/core": ">=19",
    "react": ">=18",
    "remix": ">=3",
    "solid-js": ">=1.6",
    "vue": ">=3.3"
  },
  "peerDependenciesMeta": {
    "@angular/core": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "remix": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "devDependencies": {
    "@angular/core": "^22.2.6",
    "@iconify-json/bi": "^1.2.7",
    "@iconify-json/bx": "^1.2.3",
    "@iconify-json/carbon": "^1.2.30",
    "@iconify-json/fa6-brands": "^1.2.6",
    "@iconify-json/fa6-regular": "^1.2.4",
    "@iconify-json/fa6-solid": "^1.2.4",
    "@iconify-json/feather": "^1.2.1",
    "@iconify-json/heroicons": "^1.2.3",
    "@iconify-json/iconoir": "^1.2.12",
    "@iconify-json/ion": "^1.2.7",
    "@iconify-json/lucide": "^1.2.156",
    "@iconify-json/material-symbols": "^1.2.101",
    "@iconify-json/mdi": "^1.2.3",
    "@iconify-json/mingcute": "^1.2.10",
    "@iconify-json/octicon": "^1.2.40",
    "@iconify-json/ph": "^1.2.2",
    "@iconify-json/radix-icons": "^1.2.6",
    "@iconify-json/ri": "^1.2.10",
    "@iconify-json/simple-icons": "^1.2.103",
    "@iconify-json/solar": "^1.2.16",
    "@iconify-json/tabler": "^1.2.46",
    "@phosphor-icons/core": "^2.1.1",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "esbuild": "^0.25.0",
    "lucide": "^1.74.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "remix": "^3.2.0",
    "rxjs": "^7.8.2",
    "simple-icons": "^16.38.0",
    "solid-js": "^1.9.19",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^3.0.0",
    "vue": "^3.5.45"
  },
  "keywords": [
    "liquid-glass",
    "glass",
    "svg",
    "icons",
    "webgl",
    "refraction",
    "react",
    "vue",
    "svelte",
    "solid",
    "preact",
    "angular",
    "remix"
  ],
  "engines": {
    "node": ">=18"
  }
}
