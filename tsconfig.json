{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": false,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noEmit": true,
    "types": [],
    "paths": {
      "glassity": [
        "./src/index.ts"
      ],
      "glassity/react": [
        "./src/react.tsx"
      ]
    }
  },
  "include": [
    "src",
    "test",
    "demo/*.tsx",
    "tsup.config.ts"
  ]
}
